# .env.example
# ============================================================
# Copy this file to .env and fill in your real values.
# The .env file is loaded automatically by python-dotenv in
# every page and in alerts.py.
#
# CRITICAL: Never commit your actual .env file to GitHub.
# Add .env to your .gitignore file (create one if it does not exist).
# This .env.example file is safe to commit — it has no real values.
# ============================================================

# ── Anthropic API ────────────────────────────────────────────
# Your Anthropic API key from console.anthropic.com.
# Used by: PULSE morning briefing, AI news brief, and weekly digest.
# This is SEPARATE from your Claude Pro subscription on claude.ai.
# Go to console.anthropic.com → API Keys → Create key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Alert Email Credentials ───────────────────────────────────
# The Gmail address that alerts are sent FROM.
# Must have 2-Step Verification enabled on the Google Account.
# After enabling 2-Step Verification, go to:
# myaccount.google.com/apppasswords and create an app password.
ALERT_EMAIL=youremail@gmail.com

# The Gmail App Password — this is NOT your regular Gmail password.
# It is a 16-character code generated at myaccount.google.com/apppasswords.
# Format looks like: abcd efgh ijkl mnop (without spaces: abcdefghijklmnop)
ALERT_PASSWORD=your-16-char-app-password

# The email address that alerts are sent TO.
# Can be the same as ALERT_EMAIL (send to yourself) or a different address.
ALERT_RECIPIENT=recipient@example.com
